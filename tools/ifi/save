#!/usr/bin/env bash
# ifi save "message": commits every change in the whole repo, not just the
# folder you're in. New (untracked) files only after asking.
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/common.sh"

stop_during_update
branch="$(git branch --show-current)"
[[ -n "$branch" ]] || die "You're not on a branch. Start one with: ifi fix-issue <nr>"
[[ "$branch" != main ]] || die "You're on main. Make a branch for your issue first, your" \
    "changes come along to it: ifi fix-issue <nr>"

[[ -n "$(git status --porcelain)" ]] || die "Nothing to commit: you have no changes since your last commit."

markers="$(files_with_markers)"
[[ -z "$markers" ]] || die "These files still have conflict markers (<<<<<<< or >>>>>>>):" \
    "$(sed 's/^/  /' <<<"$markers")" \
    "Keep the version you want, delete the marker lines, then ifi save again."

message="$*"
while [[ -z "${message// /}" ]]; do
    read -r -p "Short description of what you changed: " message || die ""
done

ensure_identity
new="$(new_files)"
answer=""
if [[ -n "$new" ]]; then
    echo "New files Git doesn't know yet (untracked):"
    sed 's/^/  /' <<<"$new"
    read -r -p "Add these too? (y/n) " answer || true
fi
if [[ -z "$new" || "$answer" =~ ^[YyJj] ]]; then
    run "Mark every change in the repo to be committed" git add -A
else
    run "Mark the changes to files Git knows to be committed, not the new ones" git add -u
    git diff --cached --quiet && die "Nothing to commit: you left out the new files, and nothing else changed."
fi
git diff --cached --name-status | sed -E 's/^A\t/        new      /; s/^M\t/        changed  /; s/^D\t/        deleted  /; s/^R[0-9]*\t/        renamed  /; s/^[A-Z][0-9]*\t/        changed  /'
run "Make the commit (on your computer only)" git commit -m "$message"

git_recap
your_turn
choices \
    "Done with the issue?" "ifi pull-request    (sends it to GitHub)" \
    "Not done yet?" "keep working, then ifi save again" \
    "Wrong file in there?" "ifi undo-file <file>, after ifi pull-request"
