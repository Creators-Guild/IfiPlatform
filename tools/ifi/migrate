#!/usr/bin/env bash
# ifi migrate: makes migrations for changed models, then applies them.
#
# First it asks Django whether an app has two newest migrations (yours and
# one from main, after ifi update). Django refuses to make or apply
# anything then, so it makes a merge migration that joins them first.
# MigrationLoader(None): read the files only, not the database, like
# makemigrations itself does.
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/common.sh"

find_django_python
cd "$(git rev-parse --show-toplevel)/ifiplatform"

clash="$("$DJANGO_PY" manage.py shell -c "from django.db.migrations.loader import MigrationLoader
print('ifi-clash:', *sorted(MigrationLoader(None, ignore_no_migrations=True).detect_conflicts()))" 2>/dev/null |
    sed -n 's/^ifi-clash: *//p' || true)"
if [[ -n "$clash" ]]; then
    echo "Two database changes (migrations) were made at the same time in: $clash"
    echo "That happens when you and someone else both change models. Django needs one"
    echo "more migration that joins them. It shows what it joins, and asks before it writes it."
    run "Make the migration that joins them" "$DJANGO_PY" manage.py makemigrations --merge
fi
run "Make migration files for the models you changed" "$DJANGO_PY" manage.py makemigrations
run "Apply them to your local database" "$DJANGO_PY" manage.py migrate

if [[ -n "$(git status --porcelain -- '*/migrations/*')" ]]; then
    your_turn
    choices \
        "New migration files?" "ifi save \"Short description of what you changed\"   (they belong in your commit)"
fi
