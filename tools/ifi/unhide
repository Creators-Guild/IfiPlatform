#!/usr/bin/env bash
# ifi unhide <file>: Git sees a file hidden with ifi hide again.
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/common.sh"

[[ $# -gt 0 ]] || die "Which file? For example: ifi unhide notes.txt"
exclude="$(git rev-parse --git-path info/exclude)"

for file in "$@"; do
    line="/$(git rev-parse --show-prefix)${file#./}"
    if ! grep -qxF -- "$line" "$exclude" 2>/dev/null; then
        echo "$file isn't hidden with ifi hide."
        why="$(git check-ignore -v -- "$file" || true)"
        [[ -z "$why" ]] || echo "  Git ignores it because of: ${why%%$'\t'*}  (that's for everyone)"
        continue
    fi
    grep -vxF -- "$line" "$exclude" >"$exclude.tmp" || true
    mv "$exclude.tmp" "$exclude"
    steps_heading
    step_done ok "Remove $line from .git/info/exclude, so Git sees it again"
done

$STEPS_SHOWN && your_turn "it shows as a new file again. ifi save asks before adding it."
