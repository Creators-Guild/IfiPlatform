# Django - This you have to change!
DJANGO_SECRET_KEY=your-secret-key-here

# No need to change this while you are just working on a development server
DEBUG=True

DEEPL_API_KEY=your-secret-key-here # ignore if you have no api key

# Local Database (PostgreSQL), these are only useful if you are running the 
# database locally, else ignore
DB_NAME=ifiplatform
DB_USER=ifiplatform_user
DB_PASSWORD=your-db-password-here
DB_HOST=localhost
DB_PORT=5432

DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# Email (account verification) - leave EMAIL_HOST blank to just print emails
# to the console instead of sending them (fine for local dev)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@ifiplattform.no
